{
  "name": "product-actualizer",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "actualize": "hooks/bin/actualize"
  },
  "scripts": {
    "test": "bun run typecheck && bun test && python3 tests/check.py",
    "dev": "bun --hot cockpit/server/dev.ts",
    "build": "bun run cockpit/build.ts",
    "cockpit": "bun hooks/src/cli.mjs cockpit",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/charts": "^0.18.0",
    "@xyflow/react": "^12.12.0",
    "dockview-react": "^8.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2"
  }
}
